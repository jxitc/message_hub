<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest. Merged into the debug build only; the release build
     does NOT include this receiver, so it is never exposed in production. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".receiver.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jxitc.infoagent.DEBUG_COMMAND" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
