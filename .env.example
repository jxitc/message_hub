# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///message_hub.db

# Application Settings
MAX_MESSAGE_LENGTH=10000
MAX_METADATA_SIZE=5000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# ---------------------------------------------------------------------------
# Mail Collector (optional IMAP email ingestion, see docs/mail-collector.md)
# ---------------------------------------------------------------------------
# JSON array of IMAP accounts. Works with any IMAP provider (Gmail, QQ, Outlook...).
# Leave empty/unset to disable (recommended if you run `mail_collector.py` via cron).
MAIL_ACCOUNTS='[{"host":"imap.gmail.com","user":"you@gmail.com","password":"APP_PASSWORD","port":993,"use_ssl":true,"folder":"INBOX","label":"gmail"}]'
# Alternative per-account style (MAIL_0_*, MAIL_1_*, ...) is also supported:
# MAIL_0_HOST=imap.qq.com
# MAIL_0_USER=you@qq.com
# MAIL_0_PASSWORD=authorization-code
# MAIL_0_PORT=993
# MAIL_0_USE_SSL=true
# MAIL_0_FOLDER=INBOX
# MAIL_0_LABEL=qq

# Where the mail collector POSTs messages (Message Hub base URL)
MH_URL=http://127.0.0.1:5001

# Seconds between collect cycles when the collector runs inside the server
MAIL_COLLECTOR_INTERVAL=300

# Where processed_mails.json (dedup state) is stored
# MAIL_STATE_DIR=~/.message_hub